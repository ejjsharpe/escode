{
  "targetDefaults": {
    "build": {
      "cache": true,
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "typecheck": {
      "cache": true
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/bun.lock"
      ]
    },
    "package": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "smoke": {
      "dependsOn": [
        "package"
      ],
      "cache": false
    }
  }
}
