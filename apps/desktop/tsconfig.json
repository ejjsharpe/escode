{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite-plus/client"
    ]
  },
  "exclude": ["host/vendor/codex/scripts"],
  "include": [
    "src",
    "host",
    "tests",
    "vite.config.ts",
    "playwright.config.ts",
    "../../packages"
  ]
}
