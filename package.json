{
  "name": "escode-workspace",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "nx dev desktop",
    "build": "nx build desktop",
    "typecheck": "nx typecheck desktop",
